#!/usr/bin/env bash
# Launcher for the vapi-build CLI. Works from any directory, including when this skill folder is
# symlinked into ~/.claude/skills. The repo root is three levels above this file's physical location.
set -euo pipefail
self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
  target="$(readlink "$self")"
  case "$target" in /*) self="$target" ;; *) self="$(dirname "$self")/$target" ;; esac
done
here="$(cd "$(dirname "$self")" && pwd -P)"
root="$(cd "$here/../../.." && pwd -P)"
exec env PYTHONPATH="$root${PYTHONPATH:+:$PYTHONPATH}" python3 -m vapi_build "$@"
